{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "build:vercel": "pnpm run typecheck:vercel && node ./build-vercel.mjs",
    "test:order-features": "esbuild src/tests/order-features.test.ts --bundle --platform=node --format=cjs --define:process.env.NODE_ENV='\"production\"' --outfile=/tmp/buffet-order-features.test.cjs && node --test /tmp/buffet-order-features.test.cjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:vercel": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target es2022 --esModuleInterop --skipLibCheck --noImplicitAny --strictNullChecks src/vercel-entry.ts"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
